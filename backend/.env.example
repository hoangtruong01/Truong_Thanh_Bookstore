# ==============================================================================
# 📚 TRƯỜNG THÀNH BOOKSTORE — BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# HƯỚNG DẪN SỬ DỤNG:
# 1. Sao chép tệp này sang '.env': cp .env.example .env
# 2. Cập nhật các giá trị bí mật (Secrets) phù hợp với môi trường của bạn.
# 3. Tuyệt đối KHÔNG commit tệp '.env' chứa thông tin thật lên Git repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Môi trường chạy ứng dụng: 'development' | 'production' | 'test' | 'provision'
NODE_ENV=development

# Cổng khởi chạy HTTP REST API (Mặc định: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 🗄️ 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# Chuỗi kết nối MongoDB (Local MongoDB hoặc MongoDB Atlas mongodb+srv://...)
# Ví dụ Local: mongodb://127.0.0.1:27017/truong-thanh-stationery
# Ví dụ Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/truongthanh?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/truong-thanh-stationery

# ------------------------------------------------------------------------------
# 🔐 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để ký và giải mã JWT token (BẮT BUỘC, tối thiểu 16 ký tự ở dev, >= 32 ký tự ở prod)
# Gợi ý sinh khóa ngẫu nhiên trên terminal: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_at_least_16_chars_here

# Thời hạn hết hạn của JWT Access Token (Ví dụ: 7d, 24h, 3600s)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 🌍 4. CORS & COOKIE SECURITY
# ------------------------------------------------------------------------------
# Danh sách domain Frontend được phép kết nối API (phân tách bằng dấu phẩy nếu có nhiều domain)
FRONTEND_URL=http://localhost:5173

# Cấu hình Cookie SameSite: 'lax' (khuyến nghị) | 'strict' | 'none'
COOKIE_SAME_SITE=lax

# Bật cờ Secure cho cookie (bắt buộc bật 'true' khi chạy HTTPS ở Production)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# ☁️ 5. CLOUDINARY STORAGE (TÙY CHỌN - LƯU ẢNH SẢN PHẨM & AVATAR)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 📧 6. SMTP EMAIL SERVICE (TÙY CHỌN - GỬI MAIL OTP & ĐƠN HÀNG)
# ------------------------------------------------------------------------------
# Nếu để trống, hệ thống sẽ in nội dung email ra Console / Logger ở môi trường Dev
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Trường Thành Bookstore" <no-reply@truongthanh.vn>

# ------------------------------------------------------------------------------
# 🤖 7. GOOGLE GEMINI AI (TÙY CHỌN - SINH NỘI DUNG LANDING PAGE)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 📊 8. GOOGLE SHEETS SYNC (TÙY CHỌN - ĐỒNG BỘ ĐƠN HÀNG)
# ------------------------------------------------------------------------------
GOOGLE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/xxxx/exec
