# ==============================================================================
# 📚 TRƯỜNG THÀNH BOOKSTORE — BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép tệp này sang '.env': cp .env.example .env (hoặc copy .env.example .env)
# 2. Cấu hình mặc định dưới đây đã được tối ưu để CHẠY LOCAL NGAY LẬP TỨC mà không cần
#    bất kỳ tài khoản đám mây hay dịch vụ trả phí nào bên ngoài.
# 3. Tuyệt đối KHÔNG commit file '.env' chứa thông tin thật lên Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. SERVER & APP CONFIGURATION (BẮT BUỘC)
# ------------------------------------------------------------------------------
# Môi trường chạy: 'development' | 'production' | 'test'
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
ENABLE_SWAGGER=true
STRUCTURED_LOGGING=true

# ------------------------------------------------------------------------------
# 🗄️ 2. DATABASE & CACHE (BẮT BUỘC)
# ------------------------------------------------------------------------------
# Khi chạy MongoDB Replica Set qua Docker Compose port 27017:
MONGODB_URI=mongodb://admin:admin123456@127.0.0.1:27017/truong_thanh_bookstore?replicaSet=rs0&authSource=admin
# Khi chạy MongoDB độc lập không có auth (fallback local):
# MONGODB_URI=mongodb://127.0.0.1:27017/truong_thanh_bookstore

# Redis cho Distributed Rate Limiting, Throttler và Caching (port 6379)
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 🔐 3. AUTHENTICATION & JWT SECURITY (BẮT BUỘC - TỐI THIỂU 32 KÝ TỰ)
# ------------------------------------------------------------------------------
JWT_SECRET=local-development-access-secret-32-chars-minimum
JWT_REFRESH_SECRET=local-development-refresh-secret-32-chars-minimum
JWT_RESET_SECRET=local-development-reset-secret-32-chars-minimum

# Thời hạn sống token
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cấu hình Cookie an toàn
# Local: SameSite=lax, Secure=false
# Production HTTPS: SameSite=lax hoặc none (nếu cross-domain), Secure=true
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 🌱 4. SEED DỮ LIỆU MẪU LOCAL DEV (TÙY CHỌN KHI KHỞI ĐỘNG)
# ------------------------------------------------------------------------------
# Đặt 'true' nếu muốn server tự động seed khi start, hoặc dùng lệnh 'npm run seed'
AUTO_SEED=false
RESET_DATABASE_ON_SEED=false

# Mật khẩu mẫu cho các tài khoản seed (nếu để trống, hệ thống dùng mật khẩu mặc định an toàn cho local)
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123456
SEED_ADMIN_PASSWORD=Admin@123456
SEED_STAFF_PASSWORD=Staff@123456
SEED_CUSTOMER_PASSWORD=Customer@123456

# ------------------------------------------------------------------------------
# 💳 5. PAYMENT GATEWAYS (MẶC ĐỊNH BẬT COD CHO LOCAL)
# ------------------------------------------------------------------------------
ENABLED_PAYMENT_METHODS=COD,VNPAY,MOMO
PAYMENT_WEBHOOK_SECRET=local-payment-webhook-secret-key-32chars

# VNPay Sandbox credentials
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=SANDBOX_TMN_CODE
VNPAY_HASH_SECRET=SANDBOX_HASH_SECRET
VNPAY_RETURN_URL=http://localhost:5173/payment/result
VNPAY_IP_ADDRESS=127.0.0.1

# MoMo Sandbox credentials
MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=MOMO_SANDBOX_PARTNER
MOMO_ACCESS_KEY=MOMO_SANDBOX_ACCESS
MOMO_SECRET_KEY=MOMO_SANDBOX_SECRET
MOMO_IPN_URL=http://localhost:3000/api/payments/momo/ipn
MOMO_RETURN_URL=http://localhost:5173/payment/result

# Thông tin chuyển khoản ngân hàng (nếu dùng)
BANK_NAME=Ngân hàng TMCP Ngoại Thương Việt Nam (Vietcombank)
BANK_ACCOUNT_NUMBER=0123456789

# ------------------------------------------------------------------------------
# 🚚 6. SHIPPING GHN SANDBOX (TÙY CHỌN)
# ------------------------------------------------------------------------------
GHN_API_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=

# ------------------------------------------------------------------------------
# 🛡️ 7. GUEST CHECKOUT & ANTI-SPAM (TÙY CHỌN)
# ------------------------------------------------------------------------------
GUEST_PENDING_ORDER_LIMIT=3
GUEST_CAPTCHA_THRESHOLD=2
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# ☁️ 8. CLOUDINARY STORAGE (TÙY CHỌN - LƯU TRỮ ẢNH)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 📧 9. SMTP EMAIL SERVICE (TÙY CHỌN - NẾU TRỐNG SẼ IN LOG RA CONSOLE)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Trường Thành Bookstore" <no-reply@truongthanh.vn>

# ------------------------------------------------------------------------------
# 🤖 10. GOOGLE GEMINI AI (TÙY CHỌN - TẠO NỘI DUNG TỰ ĐỘNG)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 📊 11. GOOGLE SHEETS SYNC (TÙY CHỌN)
# ------------------------------------------------------------------------------
GOOGLE_SHEET_WEBAPP_URL=

# ------------------------------------------------------------------------------
# 🔔 12. FIREBASE CLOUD MESSAGING (FCM) (TÙY CHỌN)
# ------------------------------------------------------------------------------
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 🔍 13. SENTRY OBSERVABILITY (TÙY CHỌN)
# ------------------------------------------------------------------------------
SENTRY_DSN=
