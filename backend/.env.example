# ==============================================================================
# 📚 TRƯỜNG THÀNH BOOKSTORE — BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# HƯỚNG DẪN SỬ DỤNG:
# 1. Sao chép tệp này sang '.env': cp .env.example .env
# 2. Cập nhật các giá trị bí mật (Secrets) phù hợp với môi trường của bạn.
# 3. Tuyệt đối KHÔNG commit tệp '.env' chứa thông tin thật lên Git repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Môi trường chạy ứng dụng: 'development' | 'production' | 'test' | 'provision'
NODE_ENV=development

# Cổng khởi chạy HTTP REST API (Mặc định: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 🗄️ 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# Chuỗi kết nối MongoDB (Local MongoDB hoặc MongoDB Atlas mongodb+srv://...)
# Ví dụ Local: mongodb://127.0.0.1:27017/truong-thanh-stationery
# Ví dụ Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/truongthanh?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/truong-thanh-stationery

# Redis dùng cho distributed rate limiting và token revocation (bắt buộc ở production)
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 🔐 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để ký và giải mã JWT Access token (BẮT BUỘC, tối thiểu 16 ký tự ở dev, >= 32 ký tự ở prod)
# Gợi ý sinh khóa ngẫu nhiên trên terminal: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_at_least_16_chars_here

# Khóa bí mật dùng riêng cho Refresh Token (BẮT BUỘC ở production, không được trùng JWT_SECRET)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_16_chars_here

# Khóa bí mật dùng riêng cho Reset Password Token (BẮT BUỘC ở production, không được trùng với các khóa trên)
JWT_RESET_SECRET=your_jwt_reset_secret_at_least_16_chars_here

# Access token nên ngắn hạn; refresh token chịu trách nhiệm duy trì phiên.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# ------------------------------------------------------------------------------
# Danh sách domain Frontend được phép kết nối API (phân tách bằng dấu phẩy nếu có nhiều domain)
FRONTEND_URL=http://localhost:5173

# Cấu hình Cookie SameSite: 'lax' (khuyến nghị cho cùng domain) | 'strict' | 'none' (khi Frontend và Backend khác domain, vd: Vercel + Render)
# LƯU Ý BẢO MẬT: Nếu COOKIE_SAME_SITE=none, trình duyệt hiện đại (Chrome/Safari) bắt buộc COOKIE_SECURE=true và kết nối HTTPS.
COOKIE_SAME_SITE=lax

# Bật cờ Secure cho cookie (bắt buộc bật 'true' khi chạy HTTPS ở Production, hoặc khi COOKIE_SAME_SITE=none)
COOKIE_SECURE=false
ENABLE_SWAGGER=true

# Quan sát hệ thống: Sentry là tùy chọn; structured JSON logging nên bật ở production.
SENTRY_DSN=
STRUCTURED_LOGGING=true

# ------------------------------------------------------------------------------
# 🌱 5. DEVELOPMENT SEEDING (MẶC ĐỊNH TẮT, KHÔNG DÙNG RESET Ở PRODUCTION)
# ------------------------------------------------------------------------------
AUTO_SEED=false
RESET_DATABASE_ON_SEED=false
# Chỉ điền các giá trị bên dưới khi chủ động bật AUTO_SEED=true.
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# ------------------------------------------------------------------------------
# ☁️ 6. CLOUDINARY STORAGE (TÙY CHỌN - LƯU ẢNH SẢN PHẨM & AVATAR)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 📧 6. SMTP EMAIL SERVICE (TÙY CHỌN - GỬI MAIL OTP & ĐƠN HÀNG)
# ------------------------------------------------------------------------------
# Nếu để trống, hệ thống sẽ in nội dung email ra Console / Logger ở môi trường Dev
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Trường Thành Bookstore" <no-reply@truongthanh.vn>

# ------------------------------------------------------------------------------
# 🤖 7. GOOGLE GEMINI AI (TÙY CHỌN - SINH NỘI DUNG LANDING PAGE)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 📊 8. GOOGLE SHEETS SYNC (TÙY CHỌN - ĐỒNG BỘ ĐƠN HÀNG)
# ------------------------------------------------------------------------------
GOOGLE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/xxxx/exec

# ------------------------------------------------------------------------------
# 💳 9. PAYMENT PROVIDERS (chỉ bật cổng đã cấu hình đủ khóa)
# ------------------------------------------------------------------------------
ENABLED_PAYMENT_METHODS=COD
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_HASH_SECRET=
VNPAY_TMN_CODE=
VNPAY_RETURN_URL=http://localhost:5173/payment/result
VNPAY_IP_ADDRESS=127.0.0.1
MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_SECRET_KEY=
MOMO_ACCESS_KEY=
MOMO_PARTNER_CODE=
MOMO_IPN_URL=http://localhost:3000/api/payments/momo/ipn
MOMO_RETURN_URL=http://localhost:5173/payment/result

# Guest checkout abuse protection. Turnstile is required after the threshold.
GUEST_PENDING_ORDER_LIMIT=3
GUEST_CAPTCHA_THRESHOLD=2
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,truongthanh.vn

# Firebase Cloud Messaging HTTP v1 service account
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# GHN shipping (use dev gateway for sandbox)
GHN_API_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=
BANK_NAME=Ngân hàng TMCP Ví dụ
BANK_ACCOUNT_NUMBER=0123456789
PAYMENT_WEBHOOK_SECRET=replace_with_a_random_webhook_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_HASH_SECRET=
MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_SECRET_KEY=
