# ==============================================================================
# 📚 TRƯỜNG THÀNH BOOKSTORE — DOCKER & LOCAL INFRASTRUCTURE ENVIRONMENT TEMPLATE
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép file này sang '.env': cp .env.example .env (hoặc copy .env.example .env trên Windows)
# 2. File này cung cấp các giá trị mặc định an toàn cho môi trường phát triển cục bộ (Local Dev).
# 3. Để khởi động MongoDB Replica Set và Redis: docker compose up -d mongodb redis
# 4. Để khởi động toàn bộ hệ thống bằng Docker: docker compose up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️ MONGODB REPLICA SET CREDENTIALS (LOCAL DEV)
# ------------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123456
MONGODB_URI=mongodb://admin:admin123456@mongodb:27017/truong_thanh_bookstore?replicaSet=rs0&authSource=admin

# ------------------------------------------------------------------------------
# ⚡ REDIS CACHE & RATE LIMITER
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 🔐 JWT SECRETS (LOCAL DEV - TỐI THIỂU 32 KÝ TỰ)
# ------------------------------------------------------------------------------
JWT_SECRET=local-development-access-secret-32-chars-minimum
JWT_REFRESH_SECRET=local-development-refresh-secret-32-chars-minimum
JWT_RESET_SECRET=local-development-reset-secret-32-chars-minimum

# ------------------------------------------------------------------------------
# 🌐 NETWORKING & DOMAINS
# ------------------------------------------------------------------------------
NODE_ENV=development
FRONTEND_URL=http://localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
STRUCTURED_LOGGING=true
SENTRY_DSN=
