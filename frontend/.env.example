# Backend REST API Base URL
# Development: http://localhost:3000/api
# Production (Ví dụ): https://truong-thanh-backend.onrender.com/api
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
