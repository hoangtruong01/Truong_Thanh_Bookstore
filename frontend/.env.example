# ==============================================================================
# 🌐 TRƯỜNG THÀNH BOOKSTORE — FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép tệp này sang '.env': cp .env.example .env (hoặc copy .env.example .env)
# 2. VITE_API_URL trỏ tới URL API của NestJS Backend
# ==============================================================================

# Backend REST API Base URL (Local Development)
VITE_API_URL=http://localhost:3000/api

# Backend Socket.IO URL (Local Development)
VITE_SOCKET_URL=http://localhost:3000

# Domain công khai chính thức của storefront (dùng cho canonical, og:url, JSON-LD). Không có dấu / cuối.
# Bỏ trống => mặc định https://truong-thanh-bookstore.vercel.app
VITE_SITE_URL=https://truong-thanh-bookstore.vercel.app
